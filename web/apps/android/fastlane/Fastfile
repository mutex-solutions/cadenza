# Uploads a signed Android App Bundle to a Google Play testing track.
#
#   bundle exec fastlane android upload aab:path/to/app-release.aab
#
# Environment:
#   PLAY_SERVICE_ACCOUNT_JSON  the Play service account's JSON key (contents, not a path)
#   PLAY_TRACK                 internal (default), alpha (closed testing), beta (open testing)
#   PLAY_RELEASE_STATUS        completed (default) or draft (needed until the app's first release is reviewed)
#   PLAY_RELEASE_NAME          shown in Play Console, e.g. "0.1.5 (1000042)"
default_platform(:android)

platform :android do
  desc "Upload an AAB to a Google Play testing track"
  lane :upload do |options|
    aab = options[:aab] || UI.user_error!("pass aab:path/to/app-release.aab")
    json = ENV["PLAY_SERVICE_ACCOUNT_JSON"].to_s
    UI.user_error!("PLAY_SERVICE_ACCOUNT_JSON is empty") if json.strip.empty?

    upload_to_play_store(
      aab: aab,
      json_key_data: json,
      track: ENV.fetch("PLAY_TRACK", "internal"),
      release_status: ENV.fetch("PLAY_RELEASE_STATUS", "completed"),
      version_name: ENV["PLAY_RELEASE_NAME"],
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_changelogs: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end
end
